# Serves the built UI and proxies the APIs so the browser only talks to one origin.
# ${USERS_API_URL}, ${CATALOG_API_URL} and ${ORDERS_API_URL} are filled in by the nginx image at start-up.
server {
  listen 8080;
  root /usr/share/nginx/html;

  location = /health {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok","service":"ui"}';
  }

  location /api/users/ {
    proxy_pass ${USERS_API_URL}/;
    proxy_set_header X-Request-Id $request_id;
  }

  location /api/catalog/ {
    proxy_pass ${CATALOG_API_URL}/;
    proxy_set_header X-Request-Id $request_id;
  }

  location /api/orders/ {
    proxy_pass ${ORDERS_API_URL}/;
    proxy_set_header X-Request-Id $request_id;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;
  }
}
